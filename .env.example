# ==============================================================================
# MISE MEAL PLANNER — MONOREPO ENVIRONMENT CONFIGURATION MASTER REFERENCE
# ==============================================================================
# This master reference document outlines the exact environment variables
# required for each target service across the monorepo.
#
# Workspaces:
# - server/  (Express + TypeScript backend deployed to Render)
# - client/  (React + Vite + TypeScript web frontend deployed to Vercel)
# - mobile/  (React Native + Expo SDK 52 mobile app built via EAS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (server/.env) — TARGET: RENDER
# ------------------------------------------------------------------------------

# [Required for Startup]
# Port for the Express HTTP listener (injected automatically by Render)
PORT=5000

# [Required for Startup]
# Execution environment: 'development', 'production', or 'test'.
# Controls cookie security (Secure, SameSite=None), error stacks, and billing locks.
NODE_ENV=production

# [Required for Startup]
# MongoDB connection URI. Use MongoDB Atlas connection string in production.
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mise_meal_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mise_meal_planner?retryWrites=true&w=majority

# [Required for Startup]
# Secret key used for signing and verifying JSON Web Tokens (min 32 random characters).
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_here

# [Required for Startup]
# Allowed CORS origins for browser cookie and request transmission (comma-separated for multiple).
# Example: https://mise-meal-planner.vercel.app,http://localhost:5173
CLIENT_URL=https://mise-meal-planner.vercel.app

# [Required for Live Billing]
# Stripe webhook signing secret (whsec_...) used to cryptographically verify inbound webhooks.
# Webhook endpoint: https://<your-render-service>.onrender.com/api/v1/subscriptions/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_whsec_here

# [Required Only for Local Development / Testing]
# In production, mock billing is strictly disabled unless explicitly set to true.
ENABLE_MOCK_BILLING=false

# [Required for Password Recovery Email Delivery]
# Resend API key (https://resend.com/api-keys) for transactional password recovery emails.
# Production requires a valid key (format: re_...).
RESEND_API_KEY=re_your_resend_api_key_here

# [Optional / Defaulted]
# Verified sender address for transactional emails (e.g. Mise <onboarding@resend.dev> or Mise <auth@yourdomain.com>).
EMAIL_FROM=Mise Meal Planner <onboarding@resend.dev>

# [Optional / Defaulted]
# Frontend base URL used to construct password reset links. Defaults to first CLIENT_URL or http://localhost:5173.
FRONTEND_URL=https://mise-meal-planner.vercel.app


# ------------------------------------------------------------------------------
# 2. WEB FRONTEND (client/.env) — TARGET: VERCEL
# ------------------------------------------------------------------------------

# [Required for Startup in Production]
# Base URL for the backend API.
# Leave blank in local development to route through the Vite proxy (http://localhost:5000).
# In production on Vercel, set to your Render backend URL without trailing slash.
VITE_API_URL=https://mise-server.onrender.com


# ------------------------------------------------------------------------------
# 3. MOBILE APPLICATION (mobile/.env) — TARGET: EXPO / EAS
# ------------------------------------------------------------------------------

# [Required for Production Builds]
# Shared backend API base URL for React Native / Expo client.
# In local development: auto-detected (Android emulator: 10.0.2.2, iOS: localhost).
# In production EAS builds: set to your Render backend URL.
EXPO_PUBLIC_API_URL=https://mise-server.onrender.com
