# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/mise_meal_planner
# Production Atlas placeholder: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mise_meal_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mise_meal_planner

# JWT Secret (Generate a secure random string for production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS (Comma-separated for multiple origins in production)
# Example: https://mise-meal-planner.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
