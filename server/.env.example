# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/mise_meal_planner
# Production Atlas placeholder: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mise_meal_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mise_meal_planner

# JWT Secret (Generate a secure random string for production)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS (Comma-separated for multiple origins in production)
# Example: https://mise-meal-planner.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Billing & Stripe Webhook Integration
# In production, mock billing is strictly disabled unless explicitly set to true
ENABLE_MOCK_BILLING=false

# Stripe Webhook Signing Secret (whsec_...) required in production for verifying inbound webhook signatures
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Transactional Email (Resend) for Password Recovery
# Obtain API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Email Address (e.g., Mise <onboarding@resend.dev> for sandbox or Mise <auth@yourdomain.com> once domain is verified)
EMAIL_FROM=Mise Meal Planner <onboarding@resend.dev>

# Validated Frontend URL for Password Reset Links (Defaults to CLIENT_URL or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Phase 2 — OpenAI Integration (Server-Side Only)
# API key is never exposed to web or mobile clients.
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OpenAI Model (defaults to gpt-4o-mini for cost efficiency and low latency)
OPENAI_MODEL=gpt-4o-mini
# OpenAI Request Timeout in milliseconds (defaults to 15000ms / 15s)
OPENAI_TIMEOUT_MS=15000
# Master toggle for AI features (default true when OPENAI_API_KEY is provided; if false or missing, deterministic fallbacks run)
ENABLE_AI_FEATURES=true
# Rate limit for AI endpoints per user/IP per 10-minute window (defaults to 15)
AI_RATE_LIMIT_MAX=15
# Free tier weekly AI query allowance (defaults to 5; Pro tier is 50)
FREE_TIER_WEEKLY_AI_QUERIES=5
